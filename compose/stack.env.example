# Template for <MEDIAHUB_HOME>/stack.env (default ~/.mediahub). Not secret.
# Run compose through compose/mh.ps1 or compose/mh.sh, which pass this file.
# Put API keys and tokens in secrets.env instead (see secrets.env.example).
# Write values as KEY=value with no quotes and no trailing comments.

# --- Stack (read by mh.ps1 / mh.sh and the compose files) ---
# What to run:
#   full (default)  MediaHub plus bundled Sonarr, Radarr, Prowlarr, FlareSolverr, qBittorrent, Plex, Bazarr.
#   core            MediaHub only. Point it at your own apps with SONARR_URL, RADARR_URL, ... in
#                   secrets.env (see secrets.env.example). Only port 8000 is published, so your own
#                   Sonarr and friends keep their ports.
# MEDIAHUB_STACK=full
# Route the bundled qBittorrent through a VPN (gluetun). Only with MEDIAHUB_STACK=full. none | gluetun
# MEDIAHUB_VPN=none
# Used when MEDIAHUB_VPN=gluetun (credentials go in vpn.env). Provider names and the settings each
# one needs: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# VPN_SERVICE_PROVIDER=mullvad
# openvpn | wireguard
# VPN_TYPE=wireguard
# Optional, comma separated, e.g. Sweden,Norway. Leave out for any.
# VPN_SERVER_COUNTRIES=
# Advanced: run a second copy beside this one (use `mh up -p other-name ...`). Prefix for container
# names, and where the dashboard port is published on the host.
# MEDIAHUB_PREFIX=
# MEDIAHUB_PORT_BIND=127.0.0.1:8000

# Host folder that holds Movies, TV and Downloads (mounted at /media). Required.
MEDIA_ROOT=/srv/media
# Timezone for the containers and for the weekly cleanup/picks times.
TZ=Etc/UTC
# User and group id the *arr/Plex containers run as (Linux: the owner of MEDIA_ROOT, see `id`).
# The mediahub container runs as this user too, so undo_delete can move the apps' files.
# `mh run --rm setup ...` runs as this user too, so on Linux it must be able to write MEDIA_ROOT
# and this folder (MEDIAHUB_HOME, for secrets.env).
PUID=1000
PGID=1000
# Optional host folder that already holds taste.md. Omit to use the mediahub-taste named volume.
# TASTE_DIR=/srv/mediahub/taste
# Optional, once: claim the bundled Plex for your Plex account. Get a code at https://plex.tv/claim
# (single use, valid 4 minutes), set it here and run `mh up -d` straight away. Delete the line
# after the claim. See compose/plex-claim.yml.
# PLEX_CLAIM=

# --- App (read by app/config.py) ---
# Name used in agent-facing text. Leave empty for "the user".
OWNER_NAME=
# Quality profile name for new requests.
DEFAULT_PROFILE=HD-720p
# request() and grab() are refused when free space on the media disk would fall below this many GB.
DISK_GUARD_GB=50
# Most requests the agent may make per hour.
REQUESTS_PER_HOUR=5
# Most releases the agent may grab per item.
AGENT_GRABS_PER_TARGET=2
# Most delete_any calls per rolling 24 hours.
DELETE_ANY_PER_DAY=3
# true (default): delete_any needs a one-time code sent through the alert channel, and is disabled
# if there is no channel. false: one call, no code, so a wrong or tricked agent can delete a title
# with nothing but its own say-so (the daily cap and the 7-day undo are then the only safety nets).
DELETE_ANY_REQUIRE_CODE=true
# Weekly cleanup prompt, "DAY HH:MM" in TZ.
WEEKLY_CLEANUP=SUN 10:00
# Weekly picks prompt, "DAY HH:MM" in TZ.
WEEKLY_PICKS=FRI 18:00
# Never propose cleaning up anything watched within this many days.
CLEANUP_MIN_DAYS=14
# false pauses the watch loop (auto-fixes and alerts) without stopping the server.
WATCH_ENABLED=true
# Extra Host names the MCP endpoint (/mcp) accepts besides 127.0.0.1 and localhost: a reverse proxy
# or Tailscale name. Comma separated, each host or host:port or host:* (any port); the same names
# are accepted as an http:// or https:// Origin. Empty (default) = localhost only, so a proxy
# that forwards its own Host gets HTTP 421. See docs/connect-remote.md.
# MCP_ALLOWED_HOSTS=

# --- qBittorrent policy (checked by status(deep), applied by `setup wire`) ---
# Download speed cap in KiB/s. 0 = unlimited.
QBIT_DL_LIMIT_KIB=2000
# Upload speed cap in KiB/s. 0 = unlimited.
QBIT_UP_LIMIT_KIB=250
# Seeding ratio limit; set only if qBittorrent has none enabled yet (an enabled one is never changed).
QBIT_MAX_RATIO=2.0
# Seeding time limit in minutes (10080 = 7 days); set only if none is enabled yet.
QBIT_MAX_SEEDING_MINUTES=10080

# --- Config as code (app/setup.py) ---
# Comma-separated Prowlarr indexer names. Leave empty to leave your indexers alone.
# Indexers `setup wire` removes from Prowlarr:
PROWLARR_DROP_INDEXERS=
# Indexers that need FlareSolverr: exactly these get the 'flare' tag (only when set).
PROWLARR_FLARE_INDEXERS=

# --- Webhook alerts (optional; the URL and key go in secrets.env) ---
# A JSON object merged over the webhook body, for a relay with its own wire format. Not secret.
# Keep it on one line in single quotes. Default body: source, from, id, thread, sent_at, sent_ns,
# kind ("alert" or "code"), message. A default field set to null is dropped. Invalid JSON is
# logged (without its content) and ignored. Example: WEBHOOK_EXTRA_JSON='{"to": "my-relay"}'
WEBHOOK_EXTRA_JSON=
