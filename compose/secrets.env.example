# Template for <MEDIAHUB_HOME>/secrets.env (default ~/.mediahub; never inside the repo).
# Non-secret settings go in <MEDIAHUB_HOME>/stack.env (see stack.env.example).
# Start with an empty file: `mh run --rm setup secrets` (README, First run) fills the app keys,
# PLEX_TOKEN once Plex is claimed, MCP_TOKEN and the qBittorrent login. It keeps every value
# you set yourself, except an app key that no longer matches the app.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
PLEX_TOKEN=
BAZARR_API_KEY=
QBIT_USER=
QBIT_PASS=
# Bearer token MCP clients send. `setup secrets` generates one if empty.
MCP_TOKEN=

# --- Your own apps (MEDIAHUB_STACK=core) ---
# Where MediaHub reaches them from inside its container. Leave blank with MEDIAHUB_STACK=full
# (the defaults point at the bundled apps). Use http://host.docker.internal:<port> for an app
# on this machine, or a LAN address such as http://192.168.1.20:8989. localhost will not work.
SONARR_URL=
RADARR_URL=
PROWLARR_URL=
PLEX_URL=
QBIT_URL=
BAZARR_URL=

# VPN credentials do not go here: see vpn.env.example (gluetun reads only that file).

# --- Alerts (optional) ---
# Channel: none | telegram | webhook. Leave blank to choose automatically: webhook if
# WEBHOOK_URL and WEBHOOK_KEY are set, else telegram if its two values are set, else none.
# With no channel, delete_any is disabled unless DELETE_ANY_REQUIRE_CODE=false.
NOTIFIER=
# telegram: message @BotFather, send /newbot, and copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# telegram: send your new bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the number at message.chat.id (do not paste that URL anywhere shared).
TELEGRAM_CHAT_ID=
# webhook: a URL that accepts a JSON POST with "Authorization: Bearer <key>", for an agent relay.
WEBHOOK_URL=
WEBHOOK_KEY=
