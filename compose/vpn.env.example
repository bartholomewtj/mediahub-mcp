# Template for <MEDIAHUB_HOME>/vpn.env (default ~/.mediahub/vpn.env), used only when
# MEDIAHUB_VPN=gluetun. Only gluetun reads this file. Never inside the repo.
# Credentials for the provider chosen in stack.env (VPN_SERVICE_PROVIDER). Fill in what your
# provider and VPN_TYPE need; see https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# openvpn:
OPENVPN_USER=
OPENVPN_PASSWORD=
# wireguard (some providers also need WIREGUARD_ADDRESSES):
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
